{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{3,}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "Global",
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "chat",
            "approved_baseline"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "date",
        "citation",
        "reference"
      ]
    },
    "decision_issue": {
      "type": "string",
      "pattern": "^https://github.com/[^/]+/[^/]+/issues/[0-9]+$"
    },
    "affects_issue_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://github.com/[^/]+/[^/]+/issues/[0-9]+$"
      },
      "uniqueItems": true
    },
    "contract_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://github.com/[^/]+/[^/]+/issues/[0-9]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "decision_id",
    "statement",
    "rationale",
    "domain",
    "phase",
    "source",
    "affects_issue_urls",
    "contract_paths"
  ]
}
