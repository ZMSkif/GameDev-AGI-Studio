{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-source-revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "approved_decision_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://github.com/[^/]+/[^/]+/issues/[0-9]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gdd_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "art_bible_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "architecture_revision": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "project_id",
    "repository",
    "revision",
    "approved_decision_urls",
    "architecture_revision",
    "recorded_at",
    "approved_by"
  ]
}
