{
  "version": "2.0.0",
  "migration_from_1_0_0": {
    "breaking": true,
    "removed": "engine",
    "read_instead": "engine_profiles.profiles.godot.engine"
  },
  "engine_profiles": {
    "selection": "per_game_with_the_owner_approved_architecture",
    "profiles": {
      "godot": {
        "engine": "Godot 4.x",
        "decided_by": [
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/12",
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/161"
        ],
        "profile_decision_issue_urls": [
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/47",
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/70",
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/118"
        ],
        "use_for": [
          "heavy_games",
          "desktop_games"
        ]
      },
      "web": {
        "engine": "Three.js (3D, 2.5D, light 2D) or PixiJS v8 (rich 2D), by game type",
        "decided_by": [
          "https://github.com/ZMSkif/GameDev-AGI-Studio/issues/161"
        ],
        "use_for": [
          "html5_portal_games"
        ],
        "language": "typescript",
        "build": "vite",
        "render": {
          "3d": "threejs_webglrenderer_webgl2",
          "2.5d": "threejs",
          "2d_lite": "threejs_orthographic_camera_dom_ui",
          "2d_rich": "pixijs_v8"
        },
        "version_policy": {
          "exact_versions": true,
          "single_threejs_copy": true,
          "upgrade_only_when_all_peer_ranges_cover": true
        },
        "evidence": [
          "vitest_deterministic_game_logic",
          "playwright_production_build",
          "physical_device",
          "blender_where_3d_assets_are_made"
        ]
      }
    }
  },
  "initial_platforms": [
    "Playgama HTML5",
    "YouTube Playables when accepted"
  ],
  "design_authority": [
    "approved GDD",
    "approved Art Bible",
    "approved architecture",
    "binding GitHub Decision Issues"
  ],
  "game_preproduction": {
    "owner_led_adaptive_interview": true,
    "allow_multiple_or_hybrid_answers": true,
    "visual_references_before_mass_production": true,
    "concept_validation_gate": true,
    "owner_can_explicitly_skip_prototype": true
  },
  "art_pipeline": [
    "readable pixel concept as proportion/color blueprint",
    "smooth stylized 2D concept",
    "high-quality stylized PBR 3D",
    "rig and animation",
    "in-engine independent visual review"
  ],
  "asset_quality": {
    "art_director_review": true,
    "default_primitive_visuals_cannot_pass": true,
    "source_license_required": true,
    "unique_game_audio": true,
    "shared_audio_library_reference_only": true,
    "automatic_audio_reuse_across_games": false
  },
  "multiplayer": {
    "assess_every_project": true,
    "do_not_force_network_services_into_offline_games": true
  },
  "qa": {
    "independent_gameplay_and_visual_review": true,
    "physical_device_evidence_required_for_device_pass": true,
    "no_fake_test_claims": true
  },
  "release": {
    "default_mode": "semi_auto",
    "owner_approval_required": true
  }
}
