{
  "description": "GameDev Studio quality-gate hooks. Every hook is a silent no-op outside a GameDev Studio project. Commands are written for bash (Git Bash on Windows); if Claude Code falls back to PowerShell they fail visibly with a ParserError and the PreToolUse guard fails open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session_start",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" guard_bash",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*git*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" guard_bash",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
