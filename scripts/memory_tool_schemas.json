{
  "about": "Argument schemas of Hindsight 1.2.3's per-bank MCP tools (tools/list on 127.0.0.1, 24.11.2026). bank_id, document_id and update_mode are removed: the memory MCP never sends them (memory skill; DEC-138).",
  "hindsight_version": "1.2.3",
  "tools": {
    "retain": {
      "properties": {
        "content": {
          "type": "string"
        },
        "context": {
          "default": "general",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "content"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "recall": {
      "properties": {
        "query": {
          "type": "string"
        },
        "max_tokens": {
          "default": 4096,
          "type": "integer"
        },
        "budget": {
          "default": "high",
          "type": "string"
        },
        "types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prefer_observations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags_match": {
          "default": "any",
          "enum": [
            "any",
            "all",
            "any_strict",
            "all_strict",
            "exact"
          ],
          "type": "string"
        },
        "tag_groups": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_scores": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal_window": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rerank": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "include_chunks": {
          "default": false,
          "type": "boolean"
        },
        "max_chunk_tokens": {
          "default": 8192,
          "type": "integer"
        },
        "include_entities": {
          "default": false,
          "type": "boolean"
        },
        "max_entity_tokens": {
          "default": 500,
          "type": "integer"
        },
        "include_source_facts": {
          "default": false,
          "type": "boolean"
        },
        "max_source_facts_tokens": {
          "default": 4096,
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "list_memories": {
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by fact type: 'world', 'experience', or 'observation'"
        },
        "q": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional text search query to filter memories"
        },
        "limit": {
          "default": 100,
          "minimum": 0,
          "type": "integer",
          "description": "Maximum number of results (default: 100)"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer",
          "description": "Pagination offset (default: 0)"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of tag names to filter by."
        },
        "tags_match": {
          "default": "any",
          "enum": [
            "any",
            "all",
            "any_strict",
            "all_strict",
            "exact"
          ],
          "type": "string",
          "description": "How to combine tags: 'any' (OR, default) or 'all' (AND)\nboth also include untagged memories; 'any_strict'/'all_strict'\nexclude untagged; 'exact' matches the tag set exactly."
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "get_memory": {
      "properties": {
        "memory_id": {
          "type": "string",
          "description": "The ID of the memory to retrieve"
        }
      },
      "required": [
        "memory_id"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "get_bank": {
      "properties": {},
      "type": "object",
      "additionalProperties": false
    }
  }
}
